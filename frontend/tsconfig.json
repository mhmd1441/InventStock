{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-playwright-smoke/types/**/*.ts",
    ".next-playwright-smoke/dev/types/**/*.ts",
    ".next-import-smoke/types/**/*.ts",
    ".next-import-smoke/dev/types/**/*.ts",
    ".next-return-smoke/types/**/*.ts",
    ".next-return-smoke/dev/types/**/*.ts",
    ".next-supplier-payment-smoke/types/**/*.ts",
    ".next-supplier-payment-smoke/dev/types/**/*.ts",
    ".next-reconciliation-smoke/types/**/*.ts",
    ".next-reconciliation-smoke/dev/types/**/*.ts",
    ".next-reconciliation-diag/types/**/*.ts",
    ".next-reconciliation-diag/dev/types/**/*.ts",
    ".next-browser-smoke/types/**/*.ts",
    ".next-browser-smoke/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
